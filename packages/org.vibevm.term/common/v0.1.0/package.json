{
  "name": "@org.vibevm/term-common",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "term-common — shared TypeScript helpers (arg/keymap/packaging) and the wire contracts every vibevm-term product honours.",
  "engines": {
    "node": ">=22.6"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./args": "./src/args.mjs",
    "./keymap": "./src/keymap.mjs",
    "./packaging": "./src/packaging.mjs",
    "./src/packaging.mjs": "./src/packaging.mjs",
    "./vvm": "./vvm/index.mjs",
    "./vvm/cli": "./vvm/cli.mjs",
    "./vvm/install": "./vvm/install.mjs",
    "./vvm/relocate": "./vvm/relocate.mjs",
    "./vvm/doctor": "./vvm/doctor.mjs",
    "./vvm/shortcuts": "./vvm/shortcuts.mjs",
    "./vvm/env": "./vvm/env.mjs",
    "./vvm/store": "./vvm/store.mjs",
    "./vvm/model": "./vvm/model.mjs",
    "./vvm/placer": "./vvm/placer.mjs",
    "./vvm/builder": "./vvm/builder.mjs",
    "./vvm/source": "./vvm/source.mjs",
    "./vvm/toml": "./vvm/toml.mjs"
  },
  "scripts": {
    "start": "echo 'term-common is a library — no start target' >&2 && exit 1",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.6.0"
  }
}
